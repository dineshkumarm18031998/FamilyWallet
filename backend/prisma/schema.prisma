generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  password  String
  name      String?
  avatar    String?
  createdAt DateTime @default(now())

  familyMembers FamilyMember[]
  expenses      Expense[]
  reviewQueue   ReviewQueue[]
  settings      Settings?
}

model Family {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  members  FamilyMember[]
  expenses Expense[]
}

model FamilyMember {
  id       String @id @default(uuid())
  userId   String
  familyId String
  role     String @default("Member") // "Owner", "Admin", "Member"

  user   User   @relation(fields: [userId], references: [id])
  family Family @relation(fields: [familyId], references: [id])

  @@unique([userId, familyId])
}

model Expense {
  id            String   @id @default(uuid())
  amount        Float
  merchant      String
  category      String
  subcategory   String?
  paymentMethod String?
  visibility    String // "Shared" or "Private"
  date          DateTime @default(now())
  notes         String?
  source        String   @default("Manual") // "Manual", "SMS", "OCR"
  isDeleted     Boolean  @default(false)
  updatedAt     DateTime @default(now()) @updatedAt

  userId   String
  familyId String?

  user   User    @relation(fields: [userId], references: [id])
  family Family? @relation(fields: [familyId], references: [id])
}

model Settings {
  id                  String  @id @default(uuid())
  userId              String  @unique
  
  // Auto Detection
  trackSMS            Boolean @default(true)
  trackNotifications  Boolean @default(true)
  trackOCR            Boolean @default(true)

  // Tracking Categories
  trackFood           Boolean @default(true)
  trackGroceries      Boolean @default(true)
  trackFuel           Boolean @default(true)
  trackUtilities      Boolean @default(true)
  trackMedical        Boolean @default(true)
  trackRecharge       Boolean @default(true)
  trackDTH            Boolean @default(true)
  trackEducation      Boolean @default(true)

  // Privacy & Sharing
  sharePrivateDetails Boolean @default(false)
  shareMerchantName   Boolean @default(true)
  shareNotes          Boolean @default(true)
  shareReceipts       Boolean @default(true)
  sharePaymentMethod  Boolean @default(true)
  defaultVisibility   String  @default("Private") // "Private" or "Shared"
  autoShare           Boolean @default(false)

  // Sync & Backup
  autoSync            Boolean @default(true)
  cloudBackup         Boolean @default(false)

  // Appearance
  appearance          String  @default("System") // "Light", "Dark", "System"

  user User @relation(fields: [userId], references: [id])
}

model ReviewQueue {
  id         String   @id @default(uuid())
  amount     Float
  merchant   String
  category   String
  date       DateTime @default(now())
  source     String // "SMS" or "Notification"
  status     String   @default("Pending") // "Pending", "Approved", "Ignored"
  confidence Int      @default(100)
  preview    String?
  timestamp  BigInt?

  userId String
  user   User   @relation(fields: [userId], references: [id])
}
